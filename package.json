{
  "name": "testbox",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:packaged": "vite build --mode packaged",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "electron:dev": "vite build --mode packaged && cross-env ELECTRON_RENDERER_URL= electron .",
    "electron:start": "electron .",
    "dist:win": "npm run build:packaged && electron-builder --win --config electron-builder.json5"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "electron@44.1.1": true,
    "@resvg/resvg-js@2.6.2": true
  }
}
